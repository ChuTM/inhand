{
  "name": "inhand-capture",
  "productName": "InHand Capture",
  "version": "1.0.0",
  "description": "InHand screen-capture helper. Owns the Screen Recording grant; streams JPEG frames to the main client over a local WebSocket.",
  "main": "main.js",
  "author": "ChuTM",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dir"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.inhand.capture",
    "productName": "InHand Capture",
    "files": [
      "main.js",
      "capture-renderer.html",
      "capture-renderer.js",
      "node_modules/ws/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": "arm64"
        }
      ],
      "category": "public.app-category.utilities",
      "identity": null
    },
    "directories": {
      "output": "dist"
    }
  }
}
