{
  "name": "inhand-admin",
  "version": "2.0.2",
  "description": "Admin control panel for InHand.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder"
  },
  "build": {
    "appId": "chutm.inhand.admin.app",
    "productName": "InHand Admin",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "icon": "res/logo.icns",
      "identity": "-",
      "category": "public.app-category.utilities",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "icon": "res/logo.icns",
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    }
  },
  "author": "Chu Tsz Ming",
  "license": "UNLICENSED",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.8.1"
  }
}
